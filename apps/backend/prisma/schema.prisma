// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  departments Department[]
  subscription Subscription?
}

model Department {
  id            String   @id @default(uuid())
  name          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  users         User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  DEPARTMENT_ADMIN
  HOD
  FACULTY
  REVIEWER
  EXAM_CELL
  EXTERNAL_AUDITOR
  STUDENT
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role     @default(FACULTY)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  preferences   Json?    // { emailNotifications, darkMode, autoSave, weeklyDigest, ... }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     Question[] @relation("QuestionAuthor")
  reviews       QuestionReview[]
  assessments   Assessment[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  loginHistories LoginHistory[]
  passwordResets PasswordResetToken[]
}


// ── Classes & Students ──

model ClassGroup {
  id        String    @id @default(uuid())
  name      String
  subject   String    @default("General")
  userId    String    @default("demo-faculty-id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@index([userId])
}

model Student {
  id        String     @id @default(uuid())
  groupId   String
  group     ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  rollNo    String
  email     String
  isActive  Boolean    @default(true)
  joinedAt  DateTime   @default(now())

  @@index([groupId])
}

// ── Syllabus ──

model Syllabus {
  id        String          @id @default(uuid())
  title     String
  subject   String
  grade     String
  status    String          @default("active") // active | draft | archived
  userId    String          @default("demo-faculty-id")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  topics    SyllabusTopic[]

  @@index([userId])
}

model SyllabusTopic {
  id          String             @id @default(uuid())
  syllabusId  String
  syllabus    Syllabus           @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title       String
  description String?
  duration    Int               @default(60)
  completed   Boolean           @default(false)
  topicOrder  Int               @default(0)
  subtopics   SyllabusSubtopic[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([syllabusId])
}

model SyllabusSubtopic {
  id          String        @id @default(uuid())
  topicId     String
  topic       SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean       @default(false)
  topicOrder  Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([topicId])
}


enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

model Question {
  id          String   @id @default(uuid())
  content     String   // markdown or rich text
  options     Json?    // for MCQs
  answer      String?  
  hint        String?
  subjectId   String?
  unitId      String?
  difficulty  Difficulty
  bloomLevel  BloomLevel
  
  authorId    String
  author      User     @relation("QuestionAuthor", fields: [authorId], references: [id])
  
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     QuestionReview[]
  assessments AssessmentQuestion[]

  @@index([bloomLevel])
  @@index([difficulty])
  @@index([isPublished])
  @@index([subjectId])
}

model QuestionReview {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  reviewerId  String
  reviewer    User     @relation(fields: [reviewerId], references: [id])
  status      String   // APPROVED, REJECTED, CHANGES_REQUESTED
  comments    String?
  createdAt   DateTime @default(now())
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  subjectId   String?
  totalMarks  Int      @default(100)
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   AssessmentQuestion[]
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  marks        Int        @default(1)
  order        Int        @default(0)
}

model Assignment {
  id                     String             @id @default(uuid())
  title                  String
  subject                String
  description            String             @default("")
  dueDate                DateTime
  duration               Int
  totalMarks             Int
  questionConfig         Json
  uploadedFiles          Json               @default("[]")
  additionalInstructions String             @default("")
  typeBreakdown          String?
  status                 String             @default("draft")
  generationMeta         Json?
  generationSeq          Int                @default(0)
  activeGenerationJobId  String?
  finalizedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  generatedPapers GeneratedPaper[]
  generationJobs  GenerationJob[]

  @@index([status, createdAt])
  @@index([subject])
}

model GeneratedPaper {
  id                String   @id @default(uuid())
  assignmentId      String
  assignment        Assignment @relation(fields: [assignmentId], references: [id])
  title             String
  totalMarks        Int
  duration          Int      @default(45)
  sections          Json
  canonicalMetadata Json?
  pdfPath           String?
  pdfUrl            String?
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assignmentId, generatedAt])
}

model GenerationJob {
  id              String   @id @default(uuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  bullmqJobId     String   @default("")
  generationSeq   Int      @default(0)
  progressVersion Int      @default(0)
  stageIndex      Int      @default(0)
  status          String   @default("queued")
  progress        Int      @default(0)
  error           String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assignmentId, status])
  @@index([assignmentId, generationSeq, createdAt])
  @@index([status, createdAt])
}

// ── Quiz Sessions (for /generate quiz feature) ──

model QuizSession {
  id               String              @id @default(uuid())
  topic            String
  subject          String
  difficulty       String
  bloomLevel       String
  timeLimitSeconds Int
  timeTakenSeconds Int
  totalQuestions   Int
  score            Int
  attempts         Json                // { questionIndex: chosenLetter }
  userId           String              @default("demo-faculty-id")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  questions        QuizSessionQuestion[]

  @@index([userId, createdAt])
}

model QuizSessionQuestion {
  id               String      @id @default(uuid())
  sessionId        String
  session          QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex    Int
  questionText     String
  options          Json        // string[]
  answer           String
  hint             String?
  difficulty       String
  bloomLevel       String
  aiConfidenceScore Float      @default(0.85)
  createdAt        DateTime   @default(now())

  @@index([sessionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  country   String?
  status    String   // SUCCESS, FAILED_PASSWORD, ACCOUNT_LOCKED
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PromptTemplate {
  id           String      @id @default(uuid())
  name         String      @unique
  description  String?
  versions     PromptVersion[]
}

model PromptVersion {
  id           String          @id @default(uuid())
  templateId   String
  template     PromptTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber Int
  systemPrompt String
  userPrompt   String
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  executions   PromptExecution[]
}

model PromptExecution {
  id              String         @id @default(uuid())
  promptVersionId String
  promptVersion   PromptVersion  @relation(fields: [promptVersionId], references: [id])
  providerName    String
  modelName       String
  tokensPrompt    Int
  tokensCompletion Int
  costUsd         Float
  durationMs      Int
  status          String         // SUCCESS, FAILED
  errorMessage    String?
  userId          String
  institutionId   String
  createdAt       DateTime       @default(now())
}

model QuestionBank {
  id            String              @id @default(uuid())
  content       String
  options       Json?
  answer        String?
  hint          String?
  subject       String
  topic         String
  difficulty    Difficulty
  bloomLevel    BloomLevel
  tags          String[]
  isActive      Boolean             @default(true)
  versions      QuestionVersion[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model QuestionVersion {
  id             String         @id @default(uuid())
  questionId     String
  question       QuestionBank   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versionNumber  Int
  content        String
  options        Json?
  answer         String?
  updatedBy      String
  createdAt      DateTime       @default(now())
}

model AuditLog {
  id             String      @id @default(uuid())
  userId         String?
  action         String
  ipAddress      String
  userAgent      String
  metadata       Json?
  createdAt      DateTime    @default(now())
}

model Subscription {
  id             String      @id @default(uuid())
  institutionId  String      @unique
  institution    Institution @relation(fields: [institutionId], references: [id])
  plan           String      // FREE, STARTER, PRO, ENTERPRISE
  status         String      // ACTIVE, CANCELED, PAST_DUE
  stripeCustomerId String?
  stripeSubId    String?
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}



