// â”€â”€ RAG Knowledge Base â”€â”€

model KnowledgeDocument {
  id             String                 @id @default(uuid())
  filename       String
  fileUrl        String
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]
  qualityScore   KnowledgeQualityScore?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId])
}

model KnowledgeChunk {
  id             String               @id @default(uuid())
  documentId     String
  document       KnowledgeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  content        String               @db.Text
  vector         Json
  metadata       Json?
  qualityMetrics ChunkQualityMetrics?
  createdAt      DateTime             @default(now())

  @@index([documentId])
  @@index([assignmentId])
}

model KnowledgeQualityScore {
  id         String            @id @default(uuid())
  documentId String            @unique
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  overallScore         Float
  documentCompleteness Float
  metadataCompleteness Float
  ocrConfidence        Float?
  parsingConfidence    Float?

  // Coverage Tracking
  topicCoverage  Float
  bloomCoverage  Float
  rubricCoverage Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChunkQualityMetrics {
  id      String         @id @default(uuid())
  chunkId String         @unique
  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  overallScore         Float
  chunkLength          Int
  semanticCompleteness Float
  informationDensity   Float
  duplicateRisk        Float

  // Flags
  isOrphan    Boolean @default(false)
  isOversized Boolean @default(false)
  isTiny      Boolean @default(false)

  recommendation String? // Merge, Split, Delete, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RagEvaluationBenchmark {
  id        String @id @default(uuid())
  queryType String // Question Generation, Grading, Formula

  topKAccuracy   Float
  precision      Float
  recall         Float
  mrr            Float // Mean Reciprocal Rank
  hitRate        Float
  contextQuality Float

  createdAt DateTime @default(now())
}

