generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum WorkflowStatus {
  DRAFT
  GENERATING
  GENERATED
  PARTIALLY_GENERATED
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  AVAILABLE
  STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  GRADED
  RESULT_PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

// ── Organization (tenant) ──

model Organization {
  id               String             @id @default(uuid())
  name             String
  slug             String?            @unique
  code             String             @unique
  email            String?
  phone            String?
  address          String?
  logo             String?
  brandColor       String?
  subscriptionPlan SubscriptionTier   @default(FREE)
  status           OrganizationStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  users              User[]
  invitations        Invitation[]
  classrooms         Classroom[]
  departments        Department[]
  classes            Class[]
  groups             Group[]
  subscription       Subscription?
  assignments        Assignment[]
  generatedPapers    GeneratedPaper[]
  quizSessions       QuizSession[]
  questionBanks      QuestionBank[]
  auditLogs          AuditLog[]
  studentSubmissions StudentSubmission[]
  notifications      Notification[]
  questions          Question[]          @relation("OrganizationQuestions")
  assessments        Assessment[]        @relation("OrganizationAssessments")
  syllabuses         Syllabus[]
  lessonPlans        LessonPlan[]
  worksheets         Worksheet[]
  generatedNotes     GeneratedNotes[]
  promptExecutions   PromptExecution[]
  aiRecommendations  AIRecommendation[]
  rubrics            Rubric[]
  promptTemplates    PromptTemplate[]
  classGroups        ClassGroup[]
  communityPosts     CommunityPost[]
  communityGroups    CommunityGroup[]
  voiceRooms         VoiceRoom[]
  meetings           Meeting[]
  attendanceRecords  AttendanceRecord[]
}

model Department {
  id             String       @id @default(uuid())
  name           String
  code           String?
  status         String       @default("ACTIVE")
  hodId          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  passwordHash           String
  firstName              String
  lastName               String
  avatar                 String?       @db.Text
  role                   SystemRole    @default(TEACHER)
  phone                  String?
  status                 String        @default("ACTIVE")
  hasCompletedOnboarding Boolean       @default(false)
  onboardingCompletedAt  DateTime?
  forcePasswordReset     Boolean       @default(false)
  activeOrganizationId   String?
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id])
  departmentId           String?
  department             Department?   @relation(fields: [departmentId], references: [id])
  preferences            Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  questions           Question[]             @relation("QuestionAuthor")
  reviews             QuestionReview[]
  assessments         Assessment[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  loginHistories      LoginHistory[]
  passwordResets      PasswordResetToken[]
  userRoles           UserRole[]
  classes             Class[]                @relation("ClassFaculty")
  groups              Group[]                @relation("GroupFaculty")
  notifications       Notification[]
  createdInvitations  Invitation[]           @relation("CreatedInvitations")
  taughtSections      Section[]              @relation("TeacherSections")
  enrollments         Enrollment[]           @relation("StudentEnrollments")
  createdAssignments  Assignment[]           @relation("AssignmentCreator")
  communityPosts      CommunityPost[]        @relation("CommunityPosts")
  ownedGroups         CommunityGroup[]       @relation("OwnedGroups")
  groupMemberships    GroupMember[]          @relation("GroupMemberships")
  sentMessages        Message[]              @relation("SentMessages")
  createdVoiceRooms   VoiceRoom[]            @relation("CreatedVoiceRooms")
  voiceParticipations VoiceRoomParticipant[] @relation("VoiceParticipations")
  hostedMeetings      Meeting[]              @relation("HostedMeetings")
  questionCollections QuestionCollection[]
  auditLogs           AuditLog[]
  studentAttendance   AttendanceRecord[]     @relation("StudentAttendance")
  recordedAttendance  AttendanceRecord[]     @relation("TeacherAttendance")
  communityComments   CommunityComment[]     @relation("CommunityComments")
  savedPosts          SavedPost[]            @relation("SavedPosts")

  @@index([organizationId])
  @@index([departmentId])
  @@index([email])
}

// ── ClassGroup (legacy) ──

model ClassGroup {
  id             String        @id @default(uuid())
  name           String
  subject        String        @default("General")
  userId         String        @default("demo-faculty-id")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  students       Student[]

  @@index([userId])
}

model Student {
  id       String     @id @default(uuid())
  groupId  String
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  rollNo   String
  email    String
  isActive Boolean    @default(true)
  joinedAt DateTime   @default(now())

  @@index([groupId])
}

// ── Classroom structure ──

model Classroom {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       Section[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Section {
  id          String       @id @default(uuid())
  name        String
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User         @relation("TeacherSections", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([classroomId])
  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, studentId])
  @@index([sectionId])
  @@index([studentId])
}

// ── Invitations ──

model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           SystemRole
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String
  createdBy      User             @relation("CreatedInvitations", fields: [createdById], references: [id])
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([createdById])
}

// ── Syllabus ──

model Syllabus {
  id             String          @id @default(uuid())
  title          String
  subject        String
  grade          String
  status         String          @default("active")
  userId         String          @default("demo-faculty-id")
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  topics         SyllabusTopic[]

  @@index([userId])
  @@index([organizationId])
}

model SyllabusTopic {
  id          String             @id @default(uuid())
  syllabusId  String
  syllabus    Syllabus           @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title       String
  description String?
  duration    Int                @default(60)
  completed   Boolean            @default(false)
  topicOrder  Int                @default(0)
  subtopics   SyllabusSubtopic[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([syllabusId])
}

model SyllabusSubtopic {
  id         String        @id @default(uuid())
  topicId    String
  topic      SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  completed  Boolean       @default(false)
  topicOrder Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([topicId])
}

// ── Questions & Assessment ──

model Question {
  id         String     @id @default(uuid())
  content    String
  options    Json?
  answer     String?
  hint       String?
  subjectId  String?
  unitId     String?
  difficulty Difficulty
  bloomLevel BloomLevel

  authorId       String
  author         User          @relation("QuestionAuthor", fields: [authorId], references: [id])
  organizationId String?
  organization   Organization? @relation("OrganizationQuestions", fields: [organizationId], references: [id])

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     QuestionReview[]
  assessments AssessmentQuestion[]

  @@index([bloomLevel])
  @@index([difficulty])
  @@index([isPublished])
  @@index([subjectId])
  @@index([organizationId])
  @@index([authorId])
}

model QuestionReview {
  id              String   @id @default(uuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id])
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [id])
  status          String
  comments        String?
  reason          String?
  requiredChanges String?
  createdAt       DateTime @default(now())

  @@index([questionId])
  @@index([reviewerId])
}

model Assessment {
  id         String  @id @default(uuid())
  title      String
  subjectId  String?
  totalMarks Int     @default(100)
  status     String  @default("DRAFT")

  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  organizationId String?
  organization   Organization? @relation("OrganizationAssessments", fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions AssessmentQuestion[]

  @@index([organizationId])
  @@index([authorId])
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  marks        Int        @default(1)
  order        Int        @default(0)

  @@index([assessmentId])
  @@index([questionId])
}

// ── Assignment & Papers ──

model Assignment {
  id                     String         @id @default(uuid())
  title                  String
  subject                String
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById            String?
  createdBy              User?          @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  classId                String?
  class                  Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  description            String         @default("")
  dueDate                DateTime
  duration               Int
  totalMarks             Int
  questionConfig         Json
  uploadedFiles          Json           @default("[]")
  additionalInstructions String         @default("")
  typeBreakdown          String?
  status                 WorkflowStatus @default(DRAFT)
  approvedBy             String?
  approvedAt             DateTime?
  rejectedBy             String?
  rejectedAt             DateTime?
  reviewComments         String?
  publishedAt            DateTime?
  generationMeta         Json?
  generationSeq          Int            @default(0)
  activeGenerationJobId  String?
  finalizedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  generatedPapers GeneratedPaper[]
  generationJobs  GenerationJob[]
  submissions     StudentSubmission[]

  @@index([status, createdAt])
  @@index([subject])
  @@index([organizationId])
  @@index([createdById])
  @@index([classId])
}

model GeneratedPaper {
  id                String       @id @default(uuid())
  assignmentId      String
  assignment        Assignment   @relation(fields: [assignmentId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  totalMarks        Int
  duration          Int          @default(45)
  sections          Json
  canonicalMetadata Json?
  pdfPath           String?
  pdfUrl            String?
  generatedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([assignmentId, generatedAt])
  @@index([organizationId])
}

model GenerationJob {
  id              String     @id @default(uuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  bullmqJobId     String     @default("")
  generationSeq   Int        @default(0)
  progressVersion Int        @default(0)
  stageIndex      Int        @default(0)
  status          String     @default("queued")
  progress        Int        @default(0)
  error           String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assignmentId, status])
  @@index([assignmentId, generationSeq, createdAt])
  @@index([status, createdAt])
}

// ── Quiz Sessions ──

model QuizSession {
  id               String        @id @default(uuid())
  topic            String
  subject          String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  difficulty       String
  bloomLevel       String
  timeLimitSeconds Int
  timeTakenSeconds Int
  totalQuestions   Int
  score            Int
  attempts         Json
  userId           String        @default("demo-faculty-id")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  questions QuizSessionQuestion[]

  @@index([userId, createdAt])
  @@index([organizationId])
}

model QuizSessionQuestion {
  id                String      @id @default(uuid())
  sessionId         String
  session           QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex     Int
  questionText      String
  options           Json
  answer            String
  hint              String?
  difficulty        String
  bloomLevel        String
  aiConfidenceScore Float       @default(0.85)
  createdAt         DateTime    @default(now())

  @@index([sessionId])
}

// ── Sessions & Auth ──

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  country   String?
  status    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Prompt Templates & Execution ──

model PromptTemplate {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String?
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       PromptVersion[]

  @@index([organizationId])
}

model PromptVersion {
  id            String            @id @default(uuid())
  templateId    String
  template      PromptTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber Int
  systemPrompt  String
  userPrompt    String
  isActive      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  executions    PromptExecution[]

  @@index([templateId])
}

model PromptExecution {
  id               String        @id @default(uuid())
  promptVersionId  String
  promptVersion    PromptVersion @relation(fields: [promptVersionId], references: [id])
  providerName     String
  modelName        String
  tokensPrompt     Int
  tokensCompletion Int
  costUsd          Float
  durationMs       Int
  status           String
  errorMessage     String?
  userId           String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([promptVersionId])
}

// ── Question Bank ──

model QuestionBank {
  id             String               @id @default(uuid())
  content        String
  options        Json?
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  answer         String?
  hint           String?
  subject        String
  topic          String
  difficulty     Difficulty
  bloomLevel     BloomLevel
  tags           String[]
  isActive       Boolean              @default(true)
  versions       QuestionVersion[]
  collections    QuestionCollection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
}

model QuestionVersion {
  id            String       @id @default(uuid())
  questionId    String
  question      QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  options       Json?
  answer        String?
  updatedBy     String
  createdAt     DateTime     @default(now())

  @@index([questionId])
}

// ── Audit Log ──

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         String
  entity         String?
  entityId       String?
  ipAddress      String
  userAgent      String
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
}

// ── Subscription ──

model Subscription {
  id               String           @id @default(uuid())
  organizationId   String           @unique
  organization     Organization     @relation(fields: [organizationId], references: [id])
  plan             SubscriptionTier @default(FREE)
  status           String           @default("ACTIVE")
  stripeCustomerId String?
  stripeSubId      String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  invoices         Invoice[]

  @@index([organizationId])
}

model Invoice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String       @default("USD")
  status         String
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
}

// ── Grading ──

model Rubric {
  id             String                    @id @default(uuid())
  title          String
  description    String?
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  criteria       RubricCriterion[]
  configs        AssignmentGradingConfig[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId])
  @@index([authorId])
}

model RubricCriterion {
  id          String   @id @default(uuid())
  rubricId    String
  rubric      Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String
  maxMarks    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rubricId])
}

model AssignmentGradingConfig {
  id            String   @id @default(uuid())
  assignmentId  String   @unique
  rubricId      String?
  rubric        Rubric?  @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  answerKeyText String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Submissions ──

model StudentSubmission {
  id             String                 @id @default(uuid())
  assignmentId   String
  assignment     Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileType       String
  status         AttemptStatus          @default(SUBMITTED)
  submittedAt    DateTime               @default(now())
  evaluations    SubmissionEvaluation[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([organizationId])
}

model SubmissionEvaluation {
  id              String            @id @default(uuid())
  submissionId    String            @unique
  submission      StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score           Float
  totalMarks      Float
  generalFeedback String
  criteriaGrades  Json
  teacherOverride Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ── Collections ──

model QuestionCollection {
  id          String         @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   QuestionBank[]

  @@index([userId])
}

// ── AI Features ──

model AIRecommendation {
  id              String        @id @default(uuid())
  studentId       String?
  groupId         String?
  type            String
  content         String
  suggestedTopics Json
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([organizationId])
}

model LessonPlan {
  id             String        @id @default(uuid())
  title          String
  subject        String
  grade          String
  duration       String
  objectives     String
  activities     Json
  assessments    Json
  content        String
  userId         String        @default("demo-faculty-id")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model Worksheet {
  id             String        @id @default(uuid())
  title          String
  subject        String
  topic          String
  difficulty     String
  content        String
  answerKey      String
  userId         String        @default("demo-faculty-id")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model GeneratedNotes {
  id             String        @id @default(uuid())
  title          String
  subject        String
  topic          String
  type           String
  content        String
  userId         String        @default("demo-faculty-id")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
}

// ── RBAC ──

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  userRoles   UserRole[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ── Classes & Groups ──

model Class {
  id                String             @id @default(uuid())
  grade             String
  section           String
  academicYear      String
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facultyId         String?
  faculty           User?              @relation("ClassFaculty", fields: [facultyId], references: [id], onDelete: SetNull)
  students          ClassStudent[]
  assignments       Assignment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]

  @@index([organizationId])
  @@index([facultyId])
}

model ClassStudent {
  id       String   @id @default(uuid())
  classId  String
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String
  rollNo   String
  email    String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  @@index([classId])
}

model Group {
  id             String         @id @default(uuid())
  name           String
  subject        String         @default("General")
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facultyId      String?
  faculty        User?          @relation("GroupFaculty", fields: [facultyId], references: [id], onDelete: SetNull)
  students       GroupStudent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([facultyId])
}

model GroupStudent {
  id       String   @id @default(uuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  rollNo   String
  email    String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  @@index([groupId])
}

// ── Notifications ──

model Notification {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           String       @default("INFO")
  isRead         Boolean      @default(false)
  link           String?
  createdAt      DateTime     @default(now())

  @@index([userId, isRead])
  @@index([organizationId])
}

// ── Community Hub ──

model CommunityPost {
  id             String        @id @default(uuid())
  authorId       String
  author         User          @relation("CommunityPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title          String?
  content        String
  type           String        @default("DISCUSSION") // DISCUSSION, QUESTION, PROJECT, ANNOUNCEMENT
  attachments    Json?         @default("[]")
  tags           Json?         @default("[]")
  imageUrl       String?
  likesCount     Int           @default(0)
  commentsCount  Int           @default(0)
  status         String        @default("OPEN") // OPEN, CLOSED, RESOLVED
  visibility     String        @default("PUBLIC") // PUBLIC, PRIVATE, ORG_ONLY
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  comments       CommunityComment[]
  savedBy        SavedPost[]

  @@index([authorId])
  @@index([organizationId])
  @@index([createdAt])
}

model CommunityComment {
  id             String        @id @default(uuid())
  postId         String
  post           CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation("CommunityComments", fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
}

model SavedPost {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation("SavedPosts", fields: [userId], references: [id], onDelete: Cascade)
  postId         String
  post           CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model CommunityGroup {
  id             String        @id @default(uuid())
  name           String
  description    String?
  ownerId        String
  owner          User          @relation("OwnedGroups", fields: [ownerId], references: [id], onDelete: Cascade)
  type           String        @default("PUBLIC") // PUBLIC, PRIVATE, INVITE_ONLY
  avatar         String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members GroupMember[]

  @@index([ownerId])
  @@index([organizationId])
}

model GroupMember {
  id       String         @id @default(uuid())
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role     String         @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String // Group ID or DM Room ID
  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  message        String
  attachments    Json?    @default("[]")
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model VoiceRoom {
  id             String                 @id @default(uuid())
  name           String
  createdById    String
  createdBy      User                   @relation("CreatedVoiceRooms", fields: [createdById], references: [id], onDelete: Cascade)
  type           String                 @default("CASUAL") // STUDY, PROJECT, CASUAL, INTERVIEW
  isActive       Boolean                @default(true)
  organizationId String?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  participants   VoiceRoomParticipant[]

  @@index([createdById])
  @@index([organizationId])
}

model VoiceRoomParticipant {
  id       String    @id @default(uuid())
  roomId   String
  room     VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation("VoiceParticipations", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Meeting {
  id             String        @id @default(uuid())
  title          String
  hostId         String
  host           User          @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  meetingLink    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([hostId])
  @@index([organizationId])
}

// ── System Settings ──
model SystemSetting {
  id                String   @id @default("global")
  platformName      String   @default("Vidya AI Education")
  brandColor        String   @default("#2563EB")
  logoUrl           String?
  maintenanceMode   Boolean  @default(false)
  defaultTimezone   String   @default("UTC-5:00 Eastern Time (US & Canada)")
  dataRetentionDays Int      @default(90)
  enableAiAnalytics Boolean  @default(true)
  notifyApiSpikes   Boolean  @default(true)
  forceMfa          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// ── Attendance ──
model AttendanceRecord {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String       @default("PRESENT") // PRESENT, ABSENT
  topics         Json?        @default("[]")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedById   String
  recordedBy     User         @relation("TeacherAttendance", fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId, date])
  @@index([organizationId])
}
