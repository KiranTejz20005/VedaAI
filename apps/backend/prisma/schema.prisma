generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€ Enums â”€â”€

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum WorkflowStatus {
  DRAFT
  GENERATING
  GENERATED
  PARTIALLY_GENERATED
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  AVAILABLE
  STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  GRADED
  RESULT_PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

// â”€â”€ Organization (tenant) â”€â”€

model Organization {
  id               String             @id @default(uuid())
  name             String
  slug             String?            @unique
  code             String             @unique
  email            String?
  phone            String?
  address          String?
  logo             String?
  brandColor       String?
  subscriptionPlan SubscriptionTier   @default(FREE)
  status           OrganizationStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  users              User[]
  invitations        Invitation[]
  classrooms         Classroom[]
  departments        Department[]
  classes            Class[]
  groups             Group[]
  libraryResources   LibraryResource[]
  subscription       Subscription?
  assignments        Assignment[]
  generatedPapers    GeneratedPaper[]
  quizSessions       QuizSession[]
  questionBanks      QuestionBank[]
  auditLogs          AuditLog[]
  studentSubmissions StudentSubmission[]
  notifications      Notification[]
  questions          Question[]          @relation("OrganizationQuestions")
  assessments        Assessment[]        @relation("OrganizationAssessments")
  syllabuses         Syllabus[]
  lessonPlans        LessonPlan[]
  worksheets         Worksheet[]
  generatedNotes     GeneratedNotes[]
  promptExecutions   PromptExecution[]
  aiRecommendations  AIRecommendation[]
  rubrics            Rubric[]
  promptTemplates    PromptTemplate[]
  classGroups        ClassGroup[]
  communityPosts     CommunityPost[]
  communityGroups    CommunityGroup[]
  voiceRooms         VoiceRoom[]
  meetings           Meeting[]
  attendanceRecords  AttendanceRecord[]
  leaveApplications  LeaveApplication[]
  knowledgeDocuments KnowledgeDocument[]
  academicReports    AcademicReport[]
  copilotWorkflows   CopilotWorkflow[]
  tutorSessions      TutorSession[]
  teacherTutorConfig TeacherTutorConfig?
}

model Department {
  id             String       @id @default(uuid())
  name           String
  code           String?
  status         String       @default("ACTIVE")
  hodId          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  passwordHash           String
  firstName              String
  lastName               String
  avatar                 String?       @db.Text
  role                   SystemRole    @default(TEACHER)
  phone                  String?
  status                 String        @default("ACTIVE")
  hasCompletedOnboarding Boolean       @default(false)
  onboardingCompletedAt  DateTime?
  forcePasswordReset     Boolean       @default(false)
  activeOrganizationId   String?
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id])
  departmentId           String?
  department             Department?   @relation(fields: [departmentId], references: [id])
  preferences            Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  questions           Question[]             @relation("QuestionAuthor")
  reviews             QuestionReview[]
  assessments         Assessment[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  loginHistories      LoginHistory[]
  passwordResets      PasswordResetToken[]
  userRoles           UserRole[]
  classes             Class[]                @relation("ClassFaculty")
  groups              Group[]                @relation("GroupFaculty")
  notifications       Notification[]
  createdInvitations  Invitation[]           @relation("CreatedInvitations")
  taughtSections      Section[]              @relation("TeacherSections")
  enrollments         Enrollment[]           @relation("StudentEnrollments")
  createdAssignments  Assignment[]           @relation("AssignmentCreator")
  communityPosts      CommunityPost[]        @relation("CommunityPosts")
  ownedGroups         CommunityGroup[]       @relation("OwnedGroups")
  groupMemberships    GroupMember[]          @relation("GroupMemberships")
  sentMessages        Message[]              @relation("SentMessages")
  createdVoiceRooms   VoiceRoom[]            @relation("CreatedVoiceRooms")
  voiceParticipations VoiceRoomParticipant[] @relation("VoiceParticipations")
  hostedMeetings      Meeting[]              @relation("HostedMeetings")
  questionCollections QuestionCollection[]
  auditLogs           AuditLog[]
  studentAttendance   AttendanceRecord[]     @relation("StudentAttendance")
  recordedAttendance  AttendanceRecord[]     @relation("TeacherAttendance")
  communityComments   CommunityComment[]     @relation("CommunityComments")
  savedPosts          SavedPost[]            @relation("SavedPosts")
  leaveApplications   LeaveApplication[]     @relation("LeaveApplications")
  tutorSessions       TutorSession[]
  libraryResources    LibraryResource[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([email])
}

// â”€â”€ ClassGroup (legacy) â”€â”€

model ClassGroup {
  id             String        @id @default(uuid())
  name           String
  subject        String        @default("General")
  userId         String        @default("demo-faculty-id")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  students       Student[]

  @@index([userId])
  @@index([organizationId])
}

model Student {
  id       String     @id @default(uuid())
  groupId  String
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  rollNo   String
  email    String
  isActive Boolean    @default(true)
  joinedAt DateTime   @default(now())

  // Learning Intelligence
  learningProfile StudentLearningProfile?
  studyPlans      PersonalizedStudyPlan[]

  @@index([groupId])
}

model StudentLearningProfile {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  masteryLevel    Float @default(0.0) // 0 to 100, weighted history
  knowledgeGrowth Float @default(0.0)
  confidenceTrend Float @default(0.0) // Trend delta

  // JSON representation of the Knowledge Graph / Gaps
  weakConcepts     Json? // e.g., ["thermodynamics", "pointers"]
  strongConcepts   Json?
  learningOutcomes Json?

  // Analytics
  averageAccuracy  Float @default(0.0)
  learningSpeed    Float @default(1.0)
  consistencyScore Float @default(0.0)

  // One-to-one with predictions
  predictiveAnalytics PredictiveAnalytics?

  // Streak System Engine
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDate  DateTime?
  totalActiveDays Int       @default(0)
  weeklyActivity  Json?
  monthlyActivity Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonalizedStudyPlan {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title              String
  recommendedTopics  Json // list of topics to review
  referenceMaterials Json // References retrieved from Hybrid RAG
  estimatedTimeMins  Int
  difficultyTarget   String

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model PredictiveAnalytics {
  id        String                 @id @default(uuid())
  profileId String                 @unique
  profile   StudentLearningProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  examReadiness        Float @default(0.0) // 0 to 100%
  probabilityOfPassing Float @default(0.0)
  highRiskSubjects     Json?
  knowledgeDecayRate   Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// â”€â”€ Classroom structure â”€â”€

model Classroom {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       Section[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Section {
  id          String       @id @default(uuid())
  name        String
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User         @relation("TeacherSections", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([classroomId])
  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, studentId])
  @@index([sectionId])
  @@index([studentId])
}

// â”€â”€ Invitations â”€â”€

model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           SystemRole
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String
  createdBy      User             @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([createdById])
}

// â”€â”€ Syllabus â”€â”€

model Syllabus {
  id             String          @id @default(uuid())
  title          String
  subject        String
  grade          String
  status         String          @default("active")
  userId         String          @default("demo-faculty-id")
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  topics         SyllabusTopic[]

  @@index([userId])
  @@index([organizationId])
}

model SyllabusTopic {
  id          String             @id @default(uuid())
  syllabusId  String
  syllabus    Syllabus           @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title       String
  description String?
  duration    Int                @default(60)
  completed   Boolean            @default(false)
  topicOrder  Int                @default(0)
  subtopics   SyllabusSubtopic[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([syllabusId])
}

model SyllabusSubtopic {
  id         String        @id @default(uuid())
  topicId    String
  topic      SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  completed  Boolean       @default(false)
  topicOrder Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([topicId])
}

// â”€â”€ Questions & Assessment â”€â”€

model Question {
  id         String     @id @default(uuid())
  content    String
  options    Json?
  answer     String?
  hint       String?
  subjectId  String?
  unitId     String?
  difficulty Difficulty
  bloomLevel BloomLevel

  authorId       String
  author         User          @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation("OrganizationQuestions", fields: [organizationId], references: [id])

  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     QuestionReview[]
  assessments AssessmentQuestion[]

  @@index([bloomLevel])
  @@index([difficulty])
  @@index([isPublished])
  @@index([subjectId])
  @@index([organizationId])
  @@index([authorId])
  @@index([authorId, createdAt])
}

model QuestionReview {
  id              String   @id @default(uuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status          String
  comments        String?
  reason          String?
  requiredChanges String?
  createdAt       DateTime @default(now())

  @@index([questionId])
  @@index([reviewerId])
}

model Assessment {
  id         String  @id @default(uuid())
  title      String
  subjectId  String?
  totalMarks Int     @default(100)
  status     String  @default("DRAFT")

  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("OrganizationAssessments", fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  questions AssessmentQuestion[]

  @@index([authorId])
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  marks        Int        @default(1)
  order        Int        @default(0)

  @@index([assessmentId])
  @@index([questionId])
}

// â”€â”€ Assignment & Papers â”€â”€

model Assignment {
  id                     String         @id @default(uuid())
  title                  String
  subject                String
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById            String?
  createdBy              User?          @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  classId                String?
  class                  Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  description            String         @default("")
  dueDate                DateTime
  duration               Int
  totalMarks             Int
  questionConfig         Json
  uploadedFiles          Json           @default("[]")
  additionalInstructions String         @default("")
  typeBreakdown          String?
  status                 WorkflowStatus @default(DRAFT)
  approvedBy             String?
  approvedAt             DateTime?
  rejectedBy             String?
  rejectedAt             DateTime?
  reviewComments         String?
  publishedAt            DateTime?
  generationMeta         Json?
  generationSeq          Int            @default(0)
  activeGenerationJobId  String?
  finalizedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  generatedPapers GeneratedPaper[]
  generationJobs  GenerationJob[]
  submissions     StudentSubmission[]
  knowledgeChunks KnowledgeChunk[]

  @@index([status, createdAt])
  @@index([subject])
  @@index([organizationId])
  @@index([createdById])
  @@index([classId])
  @@index([organizationId, status, createdAt])
}

model GeneratedPaper {
  id                String       @id @default(uuid())
  assignmentId      String
  assignment        Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  totalMarks        Int
  duration          Int          @default(45)
  sections          Json
  canonicalMetadata Json?
  pdfPath           String?
  pdfUrl            String?
  generatedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([assignmentId, generatedAt])
  @@index([organizationId])
}

model GenerationJob {
  id              String     @id @default(uuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  bullmqJobId     String     @default("")
  generationSeq   Int        @default(0)
  progressVersion Int        @default(0)
  stageIndex      Int        @default(0)
  status          String     @default("queued")
  progress        Int        @default(0)
  error           String?
  organizationId  String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assignmentId, status])
  @@index([assignmentId, generationSeq, createdAt])
  @@index([status, createdAt])
  @@index([bullmqJobId])
  @@index([organizationId])
}

// â”€â”€ Quiz Sessions â”€â”€

model QuizSession {
  id               String        @id @default(uuid())
  topic            String
  subject          String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  difficulty       String
  bloomLevel       String
  timeLimitSeconds Int
  timeTakenSeconds Int
  totalQuestions   Int
  score            Int
  attempts         Json
  userId           String        @default("demo-faculty-id")

  // Adaptive Analytics
  masteryLevel Float @default(0.0) // 0 to 100
  weaknesses   Json? // Array of strings (topics/concepts)
  strengths    Json? // Array of strings (topics/concepts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions QuizSessionQuestion[]

  @@index([userId, createdAt])
  @@index([organizationId])
}

model QuizSessionQuestion {
  id                String      @id @default(uuid())
  sessionId         String
  session           QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex     Int
  questionText      String
  options           Json
  answer            String
  hint              String?
  difficulty        String
  bloomLevel        String
  aiConfidenceScore Float       @default(0.85)

  // AI Explanation & RAG Feedback
  explanation      String? @db.Text
  referenceChunks  Json? // References from Hybrid RAG
  suggestedReading String? @db.Text
  learningOutcome  String?
  adaptiveDelta    Int     @default(0) // -1 for difficulty decrease, +1 for increase, 0 for same

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, questionIndex])
}

// â”€â”€ Sessions & Auth â”€â”€

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  country   String?
  status    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// â”€â”€ Prompt Templates & Execution â”€â”€

model PromptTemplate {
  id             String          @id @default(uuid())
  name           String          @unique
  description    String?
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       PromptVersion[]

  @@index([organizationId])
}

model PromptVersion {
  id            String            @id @default(uuid())
  templateId    String
  template      PromptTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber Int
  systemPrompt  String
  userPrompt    String
  isActive      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  executions    PromptExecution[]

  @@index([templateId])
}

model PromptExecution {
  id               String        @id @default(uuid())
  promptVersionId  String
  promptVersion    PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  providerName     String
  modelName        String
  tokensPrompt     Int
  tokensCompletion Int
  costUsd          Float
  durationMs       Int
  status           String
  errorMessage     String?
  userId           String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([promptVersionId])
}

// â”€â”€ Question Bank â”€â”€

model QuestionBank {
  id             String               @id @default(uuid())
  content        String
  options        Json?
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  answer         String?
  hint           String?
  subject        String
  topic          String
  difficulty     Difficulty
  bloomLevel     BloomLevel
  tags           String[]
  isActive       Boolean              @default(true)
  versions       QuestionVersion[]
  collections    QuestionCollection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
}

model QuestionVersion {
  id            String       @id @default(uuid())
  questionId    String
  question      QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String
  options       Json?
  answer        String?
  updatedBy     String
  createdAt     DateTime     @default(now())

  @@index([questionId])
}

// â”€â”€ Audit Log â”€â”€

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  action         String
  entity         String?
  entityId       String?
  ipAddress      String
  userAgent      String
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([createdAt])
  @@index([userId])
  @@index([organizationId, createdAt])
}

// â”€â”€ Subscription â”€â”€

model Subscription {
  id               String           @id @default(uuid())
  organizationId   String           @unique
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             SubscriptionTier @default(FREE)
  status           String           @default("ACTIVE")
  stripeCustomerId String?
  stripeSubId      String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  invoices         Invoice[]

  @@index([organizationId])
}

model Invoice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String       @default("USD")
  status         String
  pdfUrl         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
}

// â”€â”€ Grading â”€â”€

model Rubric {
  id          String  @id @default(uuid())
  title       String
  description String?

  // Detailed metadata
  department String?
  course     String?
  subject    String?
  chapter    String?
  topic      String?
  difficulty String?
  language   String? @default("en")

  // Versioning
  version           Int      @default(1)
  status            String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  previousVersionId String?
  previousVersion   Rubric?  @relation("RubricHistory", fields: [previousVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextVersions      Rubric[] @relation("RubricHistory")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String

  criteria RubricCriterion[]
  configs  AssignmentGradingConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([authorId])
  @@index([previousVersionId])
}

model RubricCriterion {
  id       String @id @default(uuid())
  rubricId String
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  // Self-referencing relationship for sub-criteria
  parentId    String?
  parent      RubricCriterion?  @relation("SubCriteria", fields: [parentId], references: [id], onDelete: Cascade)
  subCriteria RubricCriterion[] @relation("SubCriteria")

  name        String
  description String @db.Text
  maxMarks    Int
  minMarks    Int    @default(0)

  // Semantic Expectations
  expectedConcepts Json? // Array of strings or objects
  expectedKeywords Json?
  bloomLevel       String?
  difficulty       String?
  teacherNotes     String? @db.Text

  // Embedding for Hybrid RAG
  vector Json? // Array of floats

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rubricId])
  @@index([parentId])
}

model AssignmentGradingConfig {
  id            String   @id @default(uuid())
  assignmentId  String   @unique
  rubricId      String?
  rubric        Rubric?  @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  answerKeyText String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([rubricId])
}

