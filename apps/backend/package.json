{
  "name": "vidyaai-backend",
  "version": "1.0.0",
  "description": "VidyaAI Backend API Server",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "main": "dist/app.js",
  "scripts": {
    "dev": "node --max-old-space-size=512 ../../node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch uploads src/app.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:connections": "ts-node-dev --transpile-only --exit-child src/scripts/test-connections.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.18.0",
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sparticuz/chromium": "^123.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pg": "^8.20.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.3.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonrepair": "^3.14.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^7.8.0",
    "puppeteer-core": "^22.3.0",
    "socket.io": "^4.7.4",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.7"
  }
}
