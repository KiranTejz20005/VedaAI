PORT=3001
NODE_ENV=development

# ── Supabase / PostgreSQL (required for all data) ────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database
# Use "Transaction pooler" connection string (port 6543) for production.
# Use "Direct connection" string (port 5432) for Prisma db push/migrate.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API keys (Dashboard → Project Settings → API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Redis (required)
REDIS_URL="redis://localhost:6379"
REDIS_BULLMQ_URL="redis://localhost:6379"

# Frontend CORS
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your_jwt_secret_here_at_least_32_characters_long"
JWT_EXPIRES_IN="7d" # Optional placeholder for token expiration

# AI Providers (at least one recommended for generation)
# ANTHROPIC_API_KEY="your_anthropic_api_key"
NVIDIA_API_KEY="your_nvidia_api_key"
GROQ_API_KEY="your_groq_api_key"
# OPENAI_API_KEY="your_openai_api_key"

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Worker
ENABLE_BACKGROUND_WORKERS=true
AI_WORKER_CONCURRENCY=1
PDF_WORKER_CONCURRENCY=1
RENDER_WORKER_MODE=both

# Python AI Engine URL
AI_ENGINE_URL="http://localhost:8000"

# Community / Real-time
SOCKET_PORT=3002
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"