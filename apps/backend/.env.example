# ==========================================
# Bloom Verify 2.0 - Backend Environment
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL via Prisma)
# Replace with your actual database URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/bloom_verify?schema=public"

# Redis Configuration (For BullMQ & Legacy processes)
REDIS_URL="redis://localhost:6379"

# Authentication
# Secret key for JWT signing
JWT_SECRET="your_super_secret_jwt_key_here"

# Services
# URL of the Python AI Engine
AI_ENGINE_URL="http://localhost:8000"

# SSO Configuration
GOOGLE_CLIENT_ID="your-google-client-id-placeholder"
X_CLIENT_ID="your-x-client-id-placeholder"
