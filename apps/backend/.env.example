PORT=3001
NODE_ENV=development

# PostgreSQL / Prisma (required for all data)
DATABASE_URL="postgresql://user:password@host:port/database"

# Redis (required)
REDIS_URL="redis://localhost:6379"
REDIS_BULLMQ_URL="redis://localhost:6379"

# Frontend CORS
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your_jwt_secret_here_at_least_32_characters_long"
JWT_EXPIRES_IN="7d" # Optional placeholder for token expiration

# AI Providers (at least one recommended for generation)
# ANTHROPIC_API_KEY="your_anthropic_api_key"
NVIDIA_API_KEY="your_nvidia_api_key"
GROQ_API_KEY="your_groq_api_key"
# OPENAI_API_KEY="your_openai_api_key"

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Worker
ENABLE_BACKGROUND_WORKERS=true
AI_WORKER_CONCURRENCY=1
PDF_WORKER_CONCURRENCY=1
RENDER_WORKER_MODE=both

# Python AI Engine URL
AI_ENGINE_URL="http://localhost:8000"

# Community / Real-time
SOCKET_PORT=3002
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"