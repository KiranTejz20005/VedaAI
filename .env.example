# ==============================================================================
# Enterprise AI Academic Operating System - Production Environment Variables
# ==============================================================================
# This template contains all required environment variables for the CI/CD pipeline
# and production cluster deployment. DO NOT commit actual secrets here.

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3001
FRONTEND_URL="https://app.production.vidya.ai"
API_URL="https://api.production.vidya.ai"

# ------------------------------------------------------------------------------
# Database & Caching
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL=""
# Redis connection string for BullMQ and Caching
REDIS_URL="redis://username:password@redis-host:6379"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Highly secure random string for signing JWT tokens (min 64 chars)
JWT_SECRET=""
# Number of bcrypt salt rounds
SALT_ROUNDS="12"
# Token Expiration times
ACCESS_TOKEN_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# AI & RAG Configuration
# ------------------------------------------------------------------------------
# Primary LLM Provider API Key
OPENAI_API_KEY=""
# Fallback LLM Provider (Optional)
ANTHROPIC_API_KEY=""
# Vector Database Connection (e.g. Pinecone or Qdrant)
VECTOR_DB_URL=""
VECTOR_DB_API_KEY=""

# ------------------------------------------------------------------------------
# Integrations (Deferred MVP Features / Future Roadmaps)
# ------------------------------------------------------------------------------
# Canvas LMS OAuth Credentials
CANVAS_CLIENT_ID=""
CANVAS_CLIENT_SECRET=""
# Stripe Payment Gateway
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
