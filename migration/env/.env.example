# =============================================================================
# Master Environment Template — VedaAI (Post-Supabase Migration)
# =============================================================================
# Copy relevant sections to:
#   apps/backend/.env
#   apps/frontend/.env

# =============================================================================
# BACKEND — apps/backend/.env
# =============================================================================

PORT=3001
NODE_ENV=development

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Use "Transaction pooler" (port 6543) for runtime (supports connection pooling)
# Use "Direct connection" (port 5432) for migrations (npx prisma db push)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# For Prisma migrations (direct connection, not pooler):
# DATABASE_DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── Supabase API (Dashboard → Project Settings → API) ────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."  # Keep secret!
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Redis (BullMQ job queues) ─────────────────────────────────────────────────
REDIS_URL="rediss://default:PASSWORD@HOST:6379"
REDIS_BULLMQ_URL="rediss://default:PASSWORD@HOST:6379"

# ── Frontend CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL="https://your-app.vercel.app"

# ── JWT (Custom auth system — unchanged) ─────────────────────────────────────
JWT_SECRET="at_least_32_characters_of_random_hex_string"
JWT_EXPIRES_IN="7d"

# ── AI Providers (at least one required for paper generation) ─────────────────
# ANTHROPIC_API_KEY="sk-ant-..."
NVIDIA_API_KEY="nvapi-..."
GROQ_API_KEY="gsk_..."
# OPENAI_API_KEY="sk-..."

# ── Storage ──────────────────────────────────────────────────────────────────
# Options: local | s3 | supabase
# For Supabase Storage, set STORAGE_TYPE=supabase (requires StorageAdapter update)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ── Workers (BullMQ) ─────────────────────────────────────────────────────────
ENABLE_BACKGROUND_WORKERS=true
AI_WORKER_CONCURRENCY=1
PDF_WORKER_CONCURRENCY=1
RENDER_WORKER_MODE=both

# ── Python AI Engine ─────────────────────────────────────────────────────────
AI_ENGINE_URL="https://your-ai-engine.onrender.com"

# ── LiveKit (Real-time voice/video) ──────────────────────────────────────────
LIVEKIT_API_KEY="API..."
LIVEKIT_API_SECRET="..."
LIVEKIT_URL="wss://your-project.livekit.cloud"

# =============================================================================
# FRONTEND — apps/frontend/.env
# =============================================================================

# ── Backend API ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ── AI Engine ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AI_ENGINE_URL="https://your-ai-engine.onrender.com"

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="random_secret_at_least_32_chars"

# ── Supabase (Public — safe to expose to browser) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# NOTE: Do NOT add SUPABASE_SERVICE_ROLE_KEY here — server-side only!

# ── Real-time ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
